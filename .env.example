# Copy to .env to override the defaults used by docker-compose.yml
# ------------------------------------------------------------------
# SQLite (default) - a named volume, no configuration needed:
SIH_DATABASE_URL=sqlite:////app/data/app.db

# PostgreSQL - enable with:  cp .env.example .env && docker compose --profile postgres up
# POSTGRES_DB=sih26147
# POSTGRES_USER=sih
# POSTGRES_PASSWORD=sih
# SIH_DATABASE_URL=postgresql+psycopg://sih:sih@db:5432/sih26147

# Runtime limits
SIH_JOB_WORKERS=2
SIH_MAX_UPLOAD_BYTES=268435456
SIH_MAX_SAMPLES_ANALYSE=12000000
